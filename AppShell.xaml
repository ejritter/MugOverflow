<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MugOverflowProject.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MugOverflowProject.Views"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <TabBar Shell.TabBarIsVisible="False">
        <ShellContent
            Title="Java Oracle"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Metabolism &amp; Kinetics"
            ContentTemplate="{DataTemplate views:MetabolismPage}"
            Route="MetabolismPage" />
    </TabBar>
</Shell>
