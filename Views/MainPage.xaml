<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:models="clr-namespace:MugOverflowProject.Models"
    xmlns:viewmodels="clr-namespace:MugOverflowProject.ViewModels"
    x:Class="MugOverflowProject.Views.MainPage"
    x:DataType="viewmodels:MainViewModel"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    Style="{StaticResource PageStyle}">

    <Grid RowDefinitions="Auto, *">

        <!-- ================================================================= -->
        <!-- 1. TOP NAVIGATION HEADER (Minimalist & Streamlined)              -->
        <!-- ================================================================= -->
        <Border
            Grid.Row="0"
            BackgroundColor="{DynamicResource SurfaceColor}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="0,0,0,1"
            Padding="20,12">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">

                <!-- Left: Minimalist Brand Header (No repeated titles) -->
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border
                        WidthRequest="38"
                        HeightRequest="38"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label
                            Text="☕"
                            FontSize="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label
                            Text="Java Oracle"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource PrimaryTextColor}" />
                        <Label
                            Text="Kinetics &amp; Counsel"
                            Style="{StaticResource CaptionLabelStyle}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Center/Right: Actions & View Switcher Tabs -->
                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">

                    <!-- Coffee Guide Quick Launcher -->
                    <Button
                        Text="📖 Coffee Guide"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="36"
                        Padding="14,0"
                        FontSize="12"
                        Command="{Binding OpenCoffeeDictionaryCommand}" />

                    <!-- View Switcher Tabs -->
                    <Border
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="2">
                            <Button
                                Text="✨ Oracle"
                                HeightRequest="32"
                                Padding="14,0"
                                FontSize="12"
                                Command="{Binding SwitchToChatTabCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsChatTabActive}" Value="True">
                                        <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button
                                Text="📊 Metabolism"
                                HeightRequest="32"
                                Padding="14,0"
                                FontSize="12"
                                Command="{Binding SwitchToStatsTabCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsStatsTabActive}" Value="True">
                                        <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Settings Gear (Opens Theme Selector) -->
                    <Button
                        Style="{StaticResource SecondaryButtonStyle}"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        Command="{Binding OpenThemeSelectorCommand}">
                        <Button.ImageSource>
                            <fluent:SymbolImageSource
                                Symbol="Settings"
                                Size="18"
                                Color="{DynamicResource PrimaryTextColor}" />
                        </Button.ImageSource>
                    </Button>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 2. MAIN BODY VIEWPORT (Scrollable)                               -->
        <!-- ================================================================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="20,16,20,24" MaximumWidthRequest="1120">

                <!-- ============================================================= -->
                <!-- VIEW 1: JAVA ORACLE CHAT STREAM (When IsChatTabActive = True) -->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsChatTabActive}">

                    <!-- Oracle Welcome Card -->
                    <Border
                        Style="{StaticResource CardBorderStyle}"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Padding="18,14">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="🔮 Seek Caffeinated Truth"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryTextColor}" />
                                <Label
                                    Text="Ask the Oracle if you should brew another cup, then log whether you obeyed or rebelled."
                                    Style="{StaticResource SmallLabelStyle}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="🔄 Reset"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HeightRequest="34"
                                Padding="12,0"
                                FontSize="12"
                                Command="{Binding ResetConversationCommand}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Chat Messages Stream (CollectionView) -->
                    <CollectionView
                        ItemsSource="{Binding ChatMessages}"
                        SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border
                                Style="{StaticResource CardBorderStyle}"
                                BackgroundColor="{DynamicResource SurfaceColor}"
                                Padding="32,36"
                                Margin="0,8">
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Label
                                        Text="☕"
                                        FontSize="44"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="The Oracle is Listening"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Select your intended coffee drink below and tap 'Ask the Oracle'."
                                        Style="{StaticResource SmallLabelStyle}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessageItem">
                                <Grid Margin="0,6">

                                    <!-- A. USER QUESTION BUBBLE (Right Aligned) -->
                                    <Border
                                        IsVisible="{Binding IsUserMessage}"
                                        HorizontalOptions="End"
                                        MaximumWidthRequest="560"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeThickness="1"
                                        Padding="16,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16,16,4,16" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="4">
                                            <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                                <Label
                                                    Text="You Asked"
                                                    Style="{StaticResource CaptionLabelStyle}"
                                                    FontAttributes="Bold" />
                                                <Label
                                                    Text="{Binding TimeString}"
                                                    Style="{StaticResource CaptionLabelStyle}" />
                                            </HorizontalStackLayout>
                                            <Label
                                                Text="{Binding MessageText}"
                                                FontSize="14"
                                                TextColor="{DynamicResource PrimaryTextColor}"
                                                LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- B. ORACLE RESPONSE BUBBLE (Left Aligned Card) -->
                                    <Border
                                        IsVisible="{Binding IsOracleMessage}"
                                        HorizontalOptions="Start"
                                        MaximumWidthRequest="620"
                                        Style="{StaticResource CardBorderStyle}"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Padding="18,16">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16,16,16,4" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="12">

                                            <!-- Oracle Header & Verdict Badge -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                <Border
                                                    Grid.Column="0"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                                    StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                        Text="🔮"
                                                        FontSize="15"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                                    <Label
                                                        Text="Oracle Verdict"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}" />
                                                    <Label
                                                        Text="{Binding TimeString}"
                                                        Style="{StaticResource CaptionLabelStyle}" />
                                                </VerticalStackLayout>

                                                <!-- Verdict Badge (YES vs NO) -->
                                                <Border
                                                    Grid.Column="2"
                                                    BackgroundColor="{Binding VerdictBadgeBgColor}"
                                                    Stroke="{Binding VerdictBadgeBorderColor}"
                                                    StrokeThickness="1"
                                                    Padding="10,4"
                                                    VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                        Text="{Binding VerdictBadgeDisplay}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{Binding VerdictBadgeTextColor}" />
                                                </Border>
                                            </Grid>

                                            <!-- Oracle Verdict Text -->
                                            <Label
                                                Text="{Binding MessageText}"
                                                FontSize="14"
                                                TextColor="{DynamicResource PrimaryTextColor}"
                                                LineBreakMode="WordWrap" />

                                            <!-- Step 1: Decision Buttons (Drank vs Skipped) -->
                                            <Border
                                                IsVisible="{Binding IsActionPending}"
                                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                                Stroke="{DynamicResource BorderColor}"
                                                StrokeThickness="1"
                                                Padding="12"
                                                Margin="0,2,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="8">
                                                    <Label
                                                        Text="What did you do?"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}" />

                                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                                        <Button
                                                            Grid.Column="0"
                                                            Text="☕ I Drank Coffee"
                                                            HeightRequest="38"
                                                            FontSize="12"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=StartDrinkSelectionCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Style="{StaticResource PrimaryButtonStyle}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Text="🚫 I Skipped"
                                                            HeightRequest="38"
                                                            FontSize="12"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=PromptSkipCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Step 2A: Confirm Drink -->
                                            <Border
                                                IsVisible="{Binding IsSelectingCoffee}"
                                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                                Stroke="{DynamicResource BorderColor}"
                                                StrokeThickness="1"
                                                Padding="12"
                                                Margin="0,2,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="8">
                                                    <Label
                                                        Text="Select the coffee you had:"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}" />

                                                    <Picker
                                                        ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=AvailableCoffeeTypes}"
                                                        ItemDisplayBinding="{Binding Name}"
                                                        SelectedItem="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SelectedCoffeePreference}"
                                                        TextColor="{DynamicResource PrimaryTextColor}"
                                                        Title="Select Drink"
                                                        FontSize="13" />

                                                    <Button
                                                        Text="✅ Confirm Drank Coffee"
                                                        HeightRequest="38"
                                                        FontSize="12"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ConfirmDrankOutcomeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Step 2B: Confirm Skip -->
                                            <Border
                                                IsVisible="{Binding IsConfirmingSkip}"
                                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                                Stroke="{DynamicResource BorderColor}"
                                                StrokeThickness="1"
                                                Padding="12"
                                                Margin="0,2,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="8">
                                                    <Label
                                                        Text="Confirm that you skipped coffee:"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}" />

                                                    <Button
                                                        Text="✅ Confirm Skipped"
                                                        HeightRequest="38"
                                                        FontSize="12"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ConfirmSkipOutcomeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Outcome Completed Badge -->
                                            <Border
                                                IsVisible="{Binding IsConfirmed}"
                                                BackgroundColor="{Binding ComplianceBadgeBgColor}"
                                                Stroke="{Binding ComplianceBadgeBorderColor}"
                                                StrokeThickness="1"
                                                Padding="12,8">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="2">
                                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                        <Label
                                                            Text="{Binding ComplianceEmoji}"
                                                            FontSize="14"
                                                            VerticalOptions="Center" />
                                                        <Label
                                                            Text="{Binding ComplianceTagText}"
                                                            FontSize="12"
                                                            FontAttributes="Bold"
                                                            TextColor="{Binding ComplianceBadgeTextColor}"
                                                            VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                    <Label
                                                        Text="{Binding OutcomeFeedbackText}"
                                                        FontSize="11"
                                                        TextColor="{Binding ComplianceBadgeTextColor}" />
                                                </VerticalStackLayout>
                                            </Border>

                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Bottom Oracle Input / Action Bar (Sleek & Unified, No Empty Bubble) -->
                    <Border
                        Style="{StaticResource CardBorderStyle}"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Padding="14,10"
                        Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">

                            <!-- Drink Label -->
                            <Label
                                Grid.Column="0"
                                Text="☕ Drink:"
                                Style="{StaticResource SmallLabelStyle}"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                            <!-- Drink Picker -->
                            <Picker
                                Grid.Column="1"
                                ItemsSource="{Binding AvailableCoffeeTypes}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedCoffeePreference}"
                                TextColor="{DynamicResource PrimaryTextColor}"
                                Title="Select Coffee"
                                FontSize="13"
                                VerticalOptions="Center" />

                            <!-- Guaranteed Caffeine Badge (Never empty) -->
                            <Border
                                Grid.Column="2"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                Padding="10,6"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label
                                    Text="{Binding SelectedCoffeeCaffeineText, StringFormat='⚡ {0}'}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource SecondaryColor}"
                                    VerticalOptions="Center" />
                            </Border>

                            <!-- Primary "Ask Oracle" Button -->
                            <Button
                                Grid.Column="3"
                                Text="🔮 Ask Oracle"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AskOracleCommand}"
                                HeightRequest="44"
                                Padding="18,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- ============================================================= -->
                <!-- VIEW 2: METABOLISM & PHARMACOKINETICS DASHBOARD               -->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsStatsTabActive}">

                    <!-- 4 Top KPI Stat Cards Grid (Prominently at the top) -->
                    <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="12">

                        <!-- Card 1: Active Caffeine In Body -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="⚡" FontSize="13" />
                                    <Label Text="Active in Body" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding ActiveCaffeineMg, StringFormat='{0:F0} mg'}"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryColor}" />
                                <Label Text="5h half-life kinetics" Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 2: Today's Total Intake -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="☕" FontSize="13" />
                                    <Label Text="Total Intake" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding TotalCaffeineTodayMg, StringFormat='{0} mg'}"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryTextColor}" />
                                <Label
                                    Text="{Binding CupsLoggedCount, StringFormat='{0} cups logged'}"
                                    Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 3: Oracle Compliance Index -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="⚖️" FontSize="13" />
                                    <Label Text="Compliance" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding CompliancePercentage, StringFormat='{0}%'}"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource SuccessColor}" />
                                <Label
                                    Text="{Binding ObeyedCount, StringFormat='{0} Obeyed • {1} Rebelled', Source={Binding RebelledCount}}"
                                    Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 4: Safe Sleep Countdown -->
                        <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="🌙" FontSize="13" />
                                    <Label Text="Sleep Ready" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding HoursToSleepReadyText}"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource SecondaryColor}" />
                                <Label
                                    Text="{Binding HoursToClearanceText, StringFormat='Clear: {0}'}"
                                    Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- 24-Hour Pharmacokinetic Elimination Decay Curve -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18,14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                    <Label
                                        Text="⚡ 24-Hour Elimination Decay Curve"
                                        Style="{StaticResource MediumLabelStyle}" />
                                    <Label
                                        Text="Real-time exponential elimination modeling: N(t) = N₀ · (0.5)^(t / 5.0h)"
                                        Style="{StaticResource SmallLabelStyle}" />
                                </VerticalStackLayout>

                                <!-- Legend -->
                                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <BoxView WidthRequest="12" HeightRequest="3" Color="#7E57C2" VerticalOptions="Center" />
                                        <Label Text="Decay Curve" Style="{StaticResource CaptionLabelStyle}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <BoxView WidthRequest="12" HeightRequest="2" Color="#2E7D32" VerticalOptions="Center" />
                                        <Label Text="Sleep (20mg)" Style="{StaticResource CaptionLabelStyle}" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Native GraphicsView Chart -->
                            <Border
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                HeightRequest="220"
                                Padding="6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <GraphicsView
                                    x:Name="MetabolismChartView"
                                    Drawable="{Binding MetabolismDrawable}"
                                    HeightRequest="208" />
                            </Border>

                            <!-- Kinetics Summary Footer -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10" Margin="0,2,0,0">
                                <Border Grid.Column="0" BackgroundColor="{DynamicResource SurfaceAltColor}" StrokeThickness="0" Padding="8,5">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="⏱️ Peak: 30–60 min" Style="{StaticResource CaptionLabelStyle}" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceAltColor}" StrokeThickness="0" Padding="8,5">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="📉 Half-Life: 5.0h" Style="{StaticResource CaptionLabelStyle}" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="{DynamicResource SurfaceAltColor}" StrokeThickness="0" Padding="8,5">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="🔬 24h Remaining: ~3.1%" Style="{StaticResource CaptionLabelStyle}" HorizontalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 2x2 Compliance Matrix & History Grid -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16">

                        <!-- Left: 2x2 Compliance Quad Matrix -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="⚖️ Compliance Matrix" Style="{StaticResource MediumLabelStyle}" />
                                <Label Text="Oracle advice vs your actual decisions." Style="{StaticResource SmallLabelStyle}" />

                                <Grid RowDefinitions="*, *" ColumnDefinitions="*, *" RowSpacing="10" ColumnSpacing="10" Margin="0,4,0,0">
                                    <!-- YES • DRANK (Obeyed) -->
                                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#E8F5E9" Stroke="#2E7D32" StrokeThickness="1" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="YES • DRANK" FontSize="11" FontAttributes="Bold" TextColor="#2E7D32" />
                                            <Label Text="{Binding ComplianceStats.YesYes}" FontSize="22" FontAttributes="Bold" TextColor="#2E7D32" />
                                            <Label Text="😇 Obeyed &amp; Had Coffee" FontSize="11" TextColor="#2E7D32" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- NO • SKIPPED (Obeyed) -->
                                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#E8F5E9" Stroke="#2E7D32" StrokeThickness="1" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="NO • SKIPPED" FontSize="11" FontAttributes="Bold" TextColor="#2E7D32" />
                                            <Label Text="{Binding ComplianceStats.NoNo}" FontSize="22" FontAttributes="Bold" TextColor="#2E7D32" />
                                            <Label Text="😇 Obeyed &amp; Rested" FontSize="11" TextColor="#2E7D32" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- YES • SKIPPED (Rebelled) -->
                                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFF3E0" Stroke="#D97706" StrokeThickness="1" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="YES • SKIPPED" FontSize="11" FontAttributes="Bold" TextColor="#D97706" />
                                            <Label Text="{Binding ComplianceStats.YesNo}" FontSize="22" FontAttributes="Bold" TextColor="#D97706" />
                                            <Label Text="😈 Rebelled &amp; Refrained" FontSize="11" TextColor="#D97706" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- NO • DRANK (Rebelled) -->
                                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FFEBEE" Stroke="#C62828" StrokeThickness="1" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="NO • DRANK" FontSize="11" FontAttributes="Bold" TextColor="#C62828" />
                                            <Label Text="{Binding ComplianceStats.NoYes}" FontSize="22" FontAttributes="Bold" TextColor="#C62828" />
                                            <Label Text="😈 Rebelled &amp; Caffeinated" FontSize="11" TextColor="#C62828" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Right: Query & Intake History Ledger (High Contrast, Fixed Bindings) -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="📜 Intake &amp; Decision Ledger" Style="{StaticResource MediumLabelStyle}" />
                                    <Label Grid.Column="1" Text="{Binding HistoryLogs.Count, StringFormat='{0} Entries'}" Style="{StaticResource CaptionLabelStyle}" />
                                </Grid>

                                <CollectionView ItemsSource="{Binding HistoryLogs}" SelectionMode="None" HeightRequest="220">
                                    <CollectionView.EmptyView>
                                        <Label Text="No decisions logged yet today." Style="{StaticResource SmallLabelStyle}" HorizontalTextAlignment="Center" Margin="0,40" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:OracleDecisionLog">
                                            <Border BackgroundColor="{DynamicResource SurfaceAltColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" Padding="12,10" Margin="0,3">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                    <!-- Time -->
                                                    <Label Grid.Column="0" Text="{Binding FormattedTime}" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" VerticalOptions="Center" />

                                                    <!-- Drink & mg -->
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                        <Label Text="{Binding FormattedCoffeeName}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding CaffeineDisplayText}" Style="{StaticResource CaptionLabelStyle}" />
                                                    </VerticalStackLayout>

                                                    <!-- Oracle Verdict & Outcome Badge -->
                                                    <Border Grid.Column="2" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" Padding="8,4" VerticalOptions="Center">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                        <Label Text="{Binding StatusBadgeText}" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                                                    </Border>

                                                    <!-- Edit Action Button -->
                                                    <Button
                                                        Grid.Column="3"
                                                        Text="✏️"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        Padding="0"
                                                        FontSize="12"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=EditLogCommand}"
                                                        CommandParameter="{Binding .}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
