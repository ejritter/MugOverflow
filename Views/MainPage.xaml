<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:models="clr-namespace:MugOverflowProject.Models"
    xmlns:viewmodels="clr-namespace:MugOverflowProject.ViewModels"
    x:Class="MugOverflowProject.Views.MainPage"
    x:DataType="viewmodels:MainViewModel"
    Style="{StaticResource PageStyle}">

    <Grid RowDefinitions="Auto, *">

        <!-- ================================================================= -->
        <!-- 1. TOP NAVIGATION HEADER                                         -->
        <!-- ================================================================= -->
        <Border
            Grid.Row="0"
            BackgroundColor="{DynamicResource SurfaceColor}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="0,0,0,1"
            Padding="20,12">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">

                <!-- Left: App Logo & Brand Identity -->
                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                    <Border
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label
                            Text="☕"
                            FontSize="22"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label
                                Text="MugOverflow"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryTextColor}"
                                VerticalOptions="Center" />
                            <Border
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                Padding="8,2"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label
                                    Text="Java Oracle"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource SecondaryColor}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label
                            Text="Caffeine Elimination Kinetics &amp; Counsel"
                            Style="{StaticResource CaptionLabelStyle}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Center/Right: Actions & View Switcher Tabs -->
                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">

                    <!-- Coffee Guide Quick Launcher -->
                    <Button
                        Text="📖 Coffee Guide"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="36"
                        Padding="14,0"
                        FontSize="12"
                        Command="{Binding OpenCoffeeDictionaryCommand}" />

                    <!-- View Switcher Tabs -->
                    <Border
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="2">
                            <Button
                                Text="✨ Java Oracle"
                                HeightRequest="32"
                                Padding="14,0"
                                FontSize="12"
                                Command="{Binding SwitchToChatTabCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsChatTabActive}" Value="True">
                                        <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button
                                Text="📊 Metabolism &amp; Stats"
                                HeightRequest="32"
                                Padding="14,0"
                                FontSize="12"
                                Command="{Binding SwitchToStatsTabCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsStatsTabActive}" Value="True">
                                        <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Settings Gear (Opens Theme Selector) -->
                    <Button
                        Style="{StaticResource SecondaryButtonStyle}"
                        WidthRequest="38"
                        HeightRequest="38"
                        Padding="0"
                        Command="{Binding OpenThemeSelectorCommand}">
                        <Button.ImageSource>
                            <fluent:SymbolImageSource
                                Symbol="Settings"
                                Size="20"
                                Color="{DynamicResource PrimaryTextColor}" />
                        </Button.ImageSource>
                    </Button>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 2. MAIN BODY VIEWPORT (Scrollable)                               -->
        <!-- ================================================================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="20,16,20,24" MaximumWidthRequest="1100">

                <!-- ============================================================= -->
                <!-- VIEW 1: JAVA ORACLE CHAT STREAM (When IsChatTabActive = True) -->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsChatTabActive}">

                    <!-- Oracle Welcome Hero Banner -->
                    <Border
                        Style="{StaticResource CardBorderStyle}"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Padding="20,16">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label
                                        Text="🔮 Ask the Java Oracle"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource PrimaryTextColor}" />
                                    <Border
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        StrokeThickness="0"
                                        Padding="8,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="50/50 Impartial"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource SecondaryColor}" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label
                                    Text="Debating whether to brew another mug? Consult the Oracle for unbiased wisdom, then log whether you obeyed or rebelled."
                                    Style="{StaticResource SmallLabelStyle}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="🔄 New Session"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HeightRequest="36"
                                Padding="12,0"
                                FontSize="12"
                                Command="{Binding ResetConversationCommand}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Chat Messages Stream (CollectionView) -->
                    <CollectionView
                        ItemsSource="{Binding ChatMessages}"
                        SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border
                                Style="{StaticResource CardBorderStyle}"
                                BackgroundColor="{DynamicResource SurfaceColor}"
                                Padding="32,40"
                                Margin="0,12">
                                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <Label
                                        Text="☕"
                                        FontSize="48"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="The Java Oracle Awaits"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Select your intended coffee drink below and ask the Oracle if you should take another sip."
                                        Style="{StaticResource SmallLabelStyle}"
                                        HorizontalTextAlignment="Center"
                                        MaximumWidthRequest="420" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessageItem">
                                <Grid Margin="0,8">

                                    <!-- A. USER QUESTION BUBBLE (Right Aligned) -->
                                    <Border
                                        IsVisible="{Binding IsUserMessage}"
                                        HorizontalOptions="End"
                                        MaximumWidthRequest="580"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeThickness="1"
                                        Padding="16,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16,16,4,16" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="6">
                                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                                <Label
                                                    Text="You Asked"
                                                    Style="{StaticResource CaptionLabelStyle}"
                                                    FontAttributes="Bold" />
                                                <Label
                                                    Text="{Binding TimeString}"
                                                    Style="{StaticResource CaptionLabelStyle}" />
                                            </HorizontalStackLayout>
                                            <Label
                                                Text="{Binding MessageText}"
                                                FontSize="14"
                                                TextColor="{DynamicResource PrimaryTextColor}"
                                                LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- B. ORACLE RESPONSE BUBBLE (Left Aligned Card) -->
                                    <Border
                                        IsVisible="{Binding IsOracleMessage}"
                                        HorizontalOptions="Start"
                                        MaximumWidthRequest="640"
                                        Style="{StaticResource CardBorderStyle}"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Padding="18,16">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16,16,16,4" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="12">

                                            <!-- Oracle Header & Verdict Badge -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                <Border
                                                    Grid.Column="0"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                                    StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                        Text="🔮"
                                                        FontSize="16"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                    <Label
                                                        Text="Java Oracle"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}" />
                                                    <Label
                                                        Text="{Binding TimeString}"
                                                        Style="{StaticResource CaptionLabelStyle}" />
                                                </VerticalStackLayout>

                                                <!-- Verdict Badge (YES vs NO) -->
                                                <Border
                                                    Grid.Column="2"
                                                    BackgroundColor="{Binding VerdictBadgeBgColor}"
                                                    Stroke="{Binding VerdictBadgeBorderColor}"
                                                    StrokeThickness="1"
                                                    Padding="10,4"
                                                    VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                        Text="{Binding VerdictBadgeDisplay}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{Binding VerdictBadgeTextColor}" />
                                                </Border>
                                            </Grid>

                                            <!-- Oracle Verdict Text -->
                                            <Label
                                                Text="{Binding MessageText}"
                                                FontSize="15"
                                                TextColor="{DynamicResource PrimaryTextColor}"
                                                LineBreakMode="WordWrap" />

                                            <!-- Interactive Outcome Step 1: Buttons Drank vs Skipped -->
                                            <Border
                                                IsVisible="{Binding IsActionPending}"
                                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                                Stroke="{DynamicResource BorderColor}"
                                                StrokeThickness="1"
                                                Padding="14"
                                                Margin="0,4,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="10">
                                                    <Label
                                                        Text="What did you decide?"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}" />

                                                    <!-- Choice Buttons: Drank vs Skipped -->
                                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                                        <Button
                                                            Grid.Column="0"
                                                            Text="☕ I Drank Coffee"
                                                            HeightRequest="38"
                                                            FontSize="12"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=StartDrinkSelectionCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Style="{StaticResource PrimaryButtonStyle}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Text="🚫 I Skipped / Water"
                                                            HeightRequest="38"
                                                            FontSize="12"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=PromptSkipCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Interactive Outcome Step 2A: Confirm Drink Selection -->
                                            <Border
                                                IsVisible="{Binding IsSelectingCoffee}"
                                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                                Stroke="{DynamicResource BorderColor}"
                                                StrokeThickness="1"
                                                Padding="14"
                                                Margin="0,4,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="10">
                                                    <Label
                                                        Text="Select the coffee you had:"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}" />

                                                    <Picker
                                                        ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=AvailableCoffeeTypes}"
                                                        ItemDisplayBinding="{Binding Name}"
                                                        SelectedItem="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SelectedCoffeePreference}"
                                                        TextColor="{DynamicResource PrimaryTextColor}"
                                                        Title="Select Drink"
                                                        FontSize="13" />

                                                    <Button
                                                        Text="✅ Confirm Drank Coffee"
                                                        HeightRequest="38"
                                                        FontSize="12"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ConfirmDrankOutcomeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Interactive Outcome Step 2B: Confirm Skip -->
                                            <Border
                                                IsVisible="{Binding IsConfirmingSkip}"
                                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                                Stroke="{DynamicResource BorderColor}"
                                                StrokeThickness="1"
                                                Padding="14"
                                                Margin="0,4,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="10">
                                                    <Label
                                                        Text="Confirm that you skipped coffee:"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}" />

                                                    <Button
                                                        Text="✅ Confirm Skipped"
                                                        HeightRequest="38"
                                                        FontSize="12"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ConfirmSkipOutcomeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Outcome Completed Badge -->
                                            <Border
                                                IsVisible="{Binding IsConfirmed}"
                                                BackgroundColor="{Binding ComplianceBadgeBgColor}"
                                                Stroke="{Binding ComplianceBadgeBorderColor}"
                                                StrokeThickness="1"
                                                Padding="12,8">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="4">
                                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                        <Label
                                                            Text="{Binding ComplianceEmoji}"
                                                            FontSize="16"
                                                            VerticalOptions="Center" />
                                                        <Label
                                                            Text="{Binding ComplianceTagText}"
                                                            FontSize="12"
                                                            FontAttributes="Bold"
                                                            TextColor="{Binding ComplianceBadgeTextColor}"
                                                            VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                    <Label
                                                        Text="{Binding OutcomeFeedbackText}"
                                                        FontSize="11"
                                                        TextColor="{Binding ComplianceBadgeTextColor}" />
                                                </VerticalStackLayout>
                                            </Border>

                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Bottom Oracle Input Box & Drink Selector -->
                    <Border
                        Style="{StaticResource CardBorderStyle}"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Padding="16,14"
                        Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">

                            <!-- Coffee Beverage Picker -->
                            <Grid Grid.Column="0" ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    Text="☕ Drink:"
                                    Style="{StaticResource SmallLabelStyle}"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />
                                <Picker
                                    Grid.Column="1"
                                    ItemsSource="{Binding AvailableCoffeeTypes}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedCoffeePreference}"
                                    TextColor="{DynamicResource PrimaryTextColor}"
                                    Title="Select Coffee Type"
                                    FontSize="13" />
                            </Grid>

                            <!-- Caffeine Preview Pill -->
                            <Border
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                Padding="12,6"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label
                                    Text="{Binding SelectedCoffeePreference.Caffeine, StringFormat='⚡ {0} mg Caffeine'}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource SecondaryColor}" />
                            </Border>

                            <!-- Primary "Ask Oracle" Button -->
                            <Button
                                Grid.Column="2"
                                Text="🔮 Ask the Oracle"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AskOracleCommand}"
                                HeightRequest="46"
                                Padding="20,0" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- ============================================================= -->
                <!-- VIEW 2: METABOLISM & PHARMACOKINETICS DASHBOARD               -->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="18" IsVisible="{Binding IsStatsTabActive}">

                    <!-- 4 Top KPI Stat Cards Grid -->
                    <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="12">

                        <!-- Card 1: Active Caffeine In Body -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="⚡" FontSize="14" />
                                    <Label Text="Active in Body" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding ActiveCaffeineMg, StringFormat='{0:F0} mg'}"
                                    Style="{StaticResource MetricNumberStyle}"
                                    TextColor="{DynamicResource PrimaryColor}" />
                                <Label Text="5-hour half-life kinetics" Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 2: Today's Total Intake -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="☕" FontSize="14" />
                                    <Label Text="Total Intake Today" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding TotalCaffeineTodayMg, StringFormat='{0} mg'}"
                                    Style="{StaticResource MetricNumberStyle}" />
                                <Label
                                    Text="{Binding CupsLoggedCount, StringFormat='{0} cups logged today'}"
                                    Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 3: Oracle Compliance Index -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="⚖️" FontSize="14" />
                                    <Label Text="Oracle Compliance" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding CompliancePercentage, StringFormat='{0}%'}"
                                    Style="{StaticResource MetricNumberStyle}"
                                    TextColor="{DynamicResource SuccessColor}" />
                                <Label
                                    Text="{Binding ObeyedCount, StringFormat='{0} Obeyed • {1} Rebelled', Source={Binding RebelledCount}}"
                                    Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 4: Safe Sleep Countdown -->
                        <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="🌙" FontSize="14" />
                                    <Label Text="Sleep Ready Target" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <Label
                                    Text="{Binding HoursToSleepReadyText}"
                                    Style="{StaticResource MetricNumberStyle}"
                                    TextColor="{DynamicResource SecondaryColor}" />
                                <Label
                                    Text="{Binding HoursToClearanceText, StringFormat='Full clear (&lt;1mg): {0}'}"
                                    Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- 24-Hour Pharmacokinetic Elimination Decay Curve -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                        Text="⚡ 24-Hour Caffeine Elimination Decay Curve"
                                        Style="{StaticResource MediumLabelStyle}" />
                                    <Label
                                        Text="Real-time exponential elimination modeling: N(t) = N₀ · (0.5)^(t / 5.0h)"
                                        Style="{StaticResource SmallLabelStyle}" />
                                </VerticalStackLayout>

                                <!-- Legend -->
                                <HorizontalStackLayout Grid.Column="1" Spacing="14" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <BoxView WidthRequest="12" HeightRequest="3" Color="#7E57C2" VerticalOptions="Center" />
                                        <Label Text="Decay Curve" Style="{StaticResource CaptionLabelStyle}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <BoxView WidthRequest="12" HeightRequest="2" Color="#2E7D32" VerticalOptions="Center" />
                                        <Label Text="Sleep Line (20mg)" Style="{StaticResource CaptionLabelStyle}" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Native GraphicsView Chart -->
                            <Border
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                HeightRequest="240"
                                Padding="8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <GraphicsView
                                    x:Name="MetabolismChartView"
                                    Drawable="{Binding MetabolismDrawable}"
                                    HeightRequest="224" />
                            </Border>

                            <!-- Kinetics Summary Footer -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="12" Margin="0,4,0,0">
                                <Border Grid.Column="0" BackgroundColor="{DynamicResource SurfaceAltColor}" StrokeThickness="0" Padding="10,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="⏱️ Peak Absorption: 30–60 min" Style="{StaticResource CaptionLabelStyle}" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceAltColor}" StrokeThickness="0" Padding="10,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="📉 Half-Life: 5.0 Hours" Style="{StaticResource CaptionLabelStyle}" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="{DynamicResource SurfaceAltColor}" StrokeThickness="0" Padding="10,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="🔬 24h Remaining: ~3.1%" Style="{StaticResource CaptionLabelStyle}" HorizontalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 2x2 Compliance Matrix & History Grid -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16">

                        <!-- Left: 2x2 Compliance Quad Matrix -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="⚖️ Compliance Matrix (Oracle vs Action)" Style="{StaticResource MediumLabelStyle}" />
                                <Label Text="Tracking whether you followed the Oracle's divine guidance or went rogue." Style="{StaticResource SmallLabelStyle}" />

                                <Grid RowDefinitions="*, *" ColumnDefinitions="*, *" RowSpacing="10" ColumnSpacing="10" Margin="0,6,0,0">
                                    <!-- YES • DRANK (Obeyed) -->
                                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#E8F5E9" Stroke="#2E7D32" StrokeThickness="1" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="YES • DRANK" FontSize="11" FontAttributes="Bold" TextColor="#2E7D32" />
                                            <Label Text="{Binding ComplianceStats.YesYes}" FontSize="24" FontAttributes="Bold" TextColor="#2E7D32" />
                                            <Label Text="😇 Obeyed &amp; Had Coffee" FontSize="11" TextColor="#2E7D32" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- NO • SKIPPED (Obeyed) -->
                                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#E8F5E9" Stroke="#2E7D32" StrokeThickness="1" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="NO • SKIPPED" FontSize="11" FontAttributes="Bold" TextColor="#2E7D32" />
                                            <Label Text="{Binding ComplianceStats.NoNo}" FontSize="24" FontAttributes="Bold" TextColor="#2E7D32" />
                                            <Label Text="😇 Obeyed &amp; Rested" FontSize="11" TextColor="#2E7D32" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- YES • SKIPPED (Rebelled) -->
                                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFF3E0" Stroke="#D97706" StrokeThickness="1" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="YES • SKIPPED" FontSize="11" FontAttributes="Bold" TextColor="#D97706" />
                                            <Label Text="{Binding ComplianceStats.YesNo}" FontSize="24" FontAttributes="Bold" TextColor="#D97706" />
                                            <Label Text="😈 Rebelled &amp; Refrained" FontSize="11" TextColor="#D97706" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- NO • DRANK (Rebelled) -->
                                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FFEBEE" Stroke="#C62828" StrokeThickness="1" Padding="12">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="NO • DRANK" FontSize="11" FontAttributes="Bold" TextColor="#C62828" />
                                            <Label Text="{Binding ComplianceStats.NoYes}" FontSize="24" FontAttributes="Bold" TextColor="#C62828" />
                                            <Label Text="😈 Rebelled &amp; Caffeinated" FontSize="11" TextColor="#C62828" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Right: Query & Intake History Ledger -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="📜 Intake &amp; Decision Ledger" Style="{StaticResource MediumLabelStyle}" />
                                    <Label Grid.Column="1" Text="{Binding HistoryLogs.Count, StringFormat='{0} Entries'}" Style="{StaticResource CaptionLabelStyle}" />
                                </Grid>

                                <CollectionView ItemsSource="{Binding HistoryLogs}" SelectionMode="None" HeightRequest="230">
                                    <CollectionView.EmptyView>
                                        <Label Text="No decisions logged yet today." Style="{StaticResource SmallLabelStyle}" HorizontalTextAlignment="Center" Margin="0,40" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:OracleDecisionLog">
                                            <Border BackgroundColor="{DynamicResource SurfaceAltColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" Padding="12,8" Margin="0,3">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                    <!-- Time -->
                                                    <Label Grid.Column="0" Text="{Binding FormattedTime}" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" VerticalOptions="Center" />

                                                    <!-- Drink & mg -->
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                        <Label Text="{Binding FormattedCoffeeName}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding CaffeineMg, StringFormat='{0} mg'}" Style="{StaticResource CaptionLabelStyle}" />
                                                    </VerticalStackLayout>

                                                    <!-- Oracle Verdict & Outcome Badge -->
                                                    <Border Grid.Column="2" BackgroundColor="{DynamicResource SurfaceColor}" StrokeThickness="0" Padding="8,3" VerticalOptions="Center">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                        <Label Text="{Binding StatusBadgeText}" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                                    </Border>

                                                    <!-- Edit Action Button -->
                                                    <Button
                                                        Grid.Column="3"
                                                        Text="✏️"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        Padding="0"
                                                        FontSize="12"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=EditLogCommand}"
                                                        CommandParameter="{Binding .}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>

                <!-- ============================================================= -->
                <!-- 3. FOOTER ATTRIBUTION & THEME INFO                           -->
                <!-- ============================================================= -->
                <Border
                    BackgroundColor="Transparent"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="0,1,0,0"
                    Padding="0,16,0,0"
                    Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            Text="AI engineered by EJRitter Development"
                            Style="{StaticResource CaptionLabelStyle}"
                            FontAttributes="Bold" />
                        <Label
                            Grid.Column="1"
                            Text="Pure Native .NET MAUI 10 • Impeccable XAML"
                            Style="{StaticResource CaptionLabelStyle}" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
