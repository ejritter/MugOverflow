<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:vm="clr-namespace:MugOverflowProject.ViewModels"
    xmlns:models="clr-namespace:MugOverflowProject.Models"
    xmlns:popups="clr-namespace:MugOverflowProject.Views.Popups"
    x:Class="MugOverflowProject.Views.Popups.EditLogPopup"
    x:DataType="vm:EditLogPopupViewModel"
    BackgroundColor="Transparent"
    Padding="0"
    Margin="0">

    <Border
        Style="{StaticResource CardBorderStyle}"
        MaximumWidthRequest="540"
        Padding="22,20"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <VerticalStackLayout Spacing="14">
            <!-- Modal Header -->
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <Border
                    Grid.Column="0"
                    StrokeThickness="0"
                    WidthRequest="42"
                    HeightRequest="42">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource PrimaryGradientStart}" Offset="0.0" />
                            <GradientStop Color="{DynamicResource PrimaryGradientEnd}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <fluent:SymbolIcon
                        Symbol="Edit"
                        FontSize="20"
                        ForegroundColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="Update Coffee Log" Style="{StaticResource MediumLabelStyle}" FontSize="18" />
                    <Label Text="Adjust your brewed drink or Barista consultation outcome" Style="{StaticResource CaptionLabelStyle}" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="✕"
                    Style="{StaticResource SecondaryButtonStyle}"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="12"
                    Padding="0"
                    Clicked="OnCancelClicked" />
            </Grid>

            <!-- Oracle Verdict Info Card -->
            <Border
                BackgroundColor="{DynamicResource SurfaceAltColor}"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                Padding="14,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="BARISTA VERDICT" Style="{StaticResource CaptionLabelStyle}" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.8" />
                        <Label
                            Text="{Binding OracleVerdictText}"
                            FontAttributes="Bold"
                            FontSize="15"
                            TextColor="{DynamicResource PrimaryColor}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                        <Label Text="TIMESTAMP" Style="{StaticResource CaptionLabelStyle}" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.8" HorizontalTextAlignment="End" />
                        <Label
                            Text="{Binding TimeString}"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Drank vs Skipped Toggle Buttons -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Outcome Action" Style="{StaticResource SmallLabelStyle}" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button
                        Grid.Column="0"
                        Text="☕  Brewed &amp; Drank"
                        HeightRequest="38"
                        CornerRadius="12"
                        FontSize="12"
                        Command="{Binding SetDrankCommand}"
                        CommandParameter="{x:Boolean True}"
                        Style="{StaticResource SecondaryButtonStyle}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding UserDrank}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                <Setter Property="TextColor" Value="{DynamicResource PrimaryButtonTextColor}" />
                                <Setter Property="BorderColor" Value="{DynamicResource PrimaryColor}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Text="🚫  Skipped Cup"
                        HeightRequest="38"
                        CornerRadius="12"
                        FontSize="12"
                        Command="{Binding SetDrankCommand}"
                        CommandParameter="{x:Boolean False}"
                        Style="{StaticResource SecondaryButtonStyle}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding UserDrank}" Value="False">
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                <Setter Property="TextColor" Value="{DynamicResource PrimaryButtonTextColor}" />
                                <Setter Property="BorderColor" Value="{DynamicResource PrimaryColor}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>

            <!-- Coffee Type Selection (Visible when Drank is True) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding UserDrank}">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Beverage Profile" Style="{StaticResource SmallLabelStyle}" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding SelectedCoffeeType.CaffeineDisplay, FallbackValue='0 mg'}" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" TextColor="{DynamicResource SecondaryColor}" />
                </Grid>

                <!-- 2-Column Grid of All Coffee Types -->
                <CollectionView
                    ItemsSource="{Binding AvailableCoffeeTypes}"
                    HeightRequest="156"
                    VerticalScrollBarVisibility="Always"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CoffeeType">
                            <Border
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                Padding="10,7">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type popups:EditLogPopup}}, Path=BindingContext.SelectCoffeeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="4" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Name}"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            TextColor="{DynamicResource PrimaryTextColor}"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding Volume}"
                                            FontSize="9"
                                            TextColor="{DynamicResource SecondaryTextColor}" />
                                    </VerticalStackLayout>
                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        StrokeThickness="0"
                                        Padding="6,2"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding CaffeineDisplay}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource SecondaryColor}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Currently Selected Pill -->
                <Border
                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="12,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            Text="{Binding SelectedCoffeeType.DisplayText, FallbackValue='No coffee selected'}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="✓ Active"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource SuccessColor}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Modal Footer Actions -->
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" Margin="0,6,0,0">
                <Button
                    Grid.Column="0"
                    Text="🗑 Delete"
                    Style="{StaticResource DestructiveButtonStyle}"
                    HeightRequest="36"
                    CornerRadius="12"
                    Padding="14,0"
                    FontSize="12"
                    Clicked="OnDeleteClicked" />

                <Button
                    Grid.Column="2"
                    Text="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HeightRequest="36"
                    CornerRadius="12"
                    Padding="16,0"
                    FontSize="12"
                    Clicked="OnCancelClicked" />

                <Button
                    Grid.Column="3"
                    Text="Save Changes"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="36"
                    CornerRadius="12"
                    Padding="16,0"
                    FontSize="12"
                    Clicked="OnSaveClicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
