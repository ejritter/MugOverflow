<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:vm="clr-namespace:MugOverflowProject.ViewModels"
    xmlns:models="clr-namespace:MugOverflowProject.Models"
    x:Class="MugOverflowProject.Views.Popups.EditLogPopup"
    x:DataType="vm:EditLogPopupViewModel">

    <Border
        Style="{StaticResource CardBorderStyle}"
        MaximumWidthRequest="520"
        Margin="16"
        Padding="18"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <VerticalStackLayout Spacing="14">
            <!-- Modal Header -->
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                    StrokeThickness="0"
                    Padding="10"
                    WidthRequest="40"
                    HeightRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <fluent:SymbolIcon
                        Symbol="Edit"
                        FontSize="20"
                        ForegroundColor="{DynamicResource PrimaryColor}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Edit Choice / Outcome" Style="{StaticResource MediumLabelStyle}" FontSize="18" />
                    <Label Text="Correct your logged coffee drink or decision" Style="{StaticResource CaptionLabelStyle}" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="✕"
                    Style="{StaticResource SecondaryButtonStyle}"
                    WidthRequest="36"
                    HeightRequest="36"
                    Padding="0"
                    Clicked="OnCancelClicked" />
            </Grid>

            <!-- Oracle Verdict Info Card -->
            <Border
                BackgroundColor="{DynamicResource SurfaceAltColor}"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Oracle's Suggestion:" Style="{StaticResource CaptionLabelStyle}" />
                        <Label
                            Text="{Binding OracleVerdictText}"
                            FontAttributes="Bold"
                            FontSize="15"
                            TextColor="{DynamicResource PrimaryColor}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                        <Label Text="Logged Time:" Style="{StaticResource CaptionLabelStyle}" HorizontalTextAlignment="End" />
                        <Label
                            Text="{Binding TimeString}"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Drank vs Skipped Toggle Buttons -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Did you drink coffee?" Style="{StaticResource SmallLabelStyle}" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button
                        Grid.Column="0"
                        Text="☕ Drank Coffee"
                        HeightRequest="36"
                        FontSize="12"
                        Command="{Binding SetDrankCommand}"
                        CommandParameter="{x:Boolean True}"
                        Style="{StaticResource SecondaryButtonStyle}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding UserDrank}" Value="True">
                                <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Text="🚫 Skipped Coffee"
                        HeightRequest="36"
                        FontSize="12"
                        Command="{Binding SetDrankCommand}"
                        CommandParameter="{x:Boolean False}"
                        Style="{StaticResource SecondaryButtonStyle}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding UserDrank}" Value="False">
                                <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>

            <!-- Coffee Type Selection (Visible when Drank is True) -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding UserDrank}">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Select Coffee Drink:" Style="{StaticResource SmallLabelStyle}" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding SelectedCoffeeType.CaffeineDisplay, FallbackValue='0 mg'}" Style="{StaticResource CaptionLabelStyle}" FontAttributes="Bold" TextColor="{DynamicResource AccentColor}" />
                </Grid>

                <!-- 2-Column Grid of All Coffee Types (Including Decaf) -->
                <CollectionView
                    ItemsSource="{Binding AvailableCoffeeTypes}"
                    HeightRequest="150"
                    VerticalScrollBarVisibility="Always"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="6" VerticalItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CoffeeType">
                            <Border
                                BackgroundColor="{DynamicResource SurfaceColor}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                Padding="8,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditLogPopupViewModel}}, Path=SelectCoffeeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="4" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Name}"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            TextColor="{DynamicResource PrimaryTextColor}"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding Volume}"
                                            FontSize="9"
                                            TextColor="{DynamicResource SecondaryTextColor}" />
                                    </VerticalStackLayout>
                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        StrokeThickness="0"
                                        Padding="5,2"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding CaffeineDisplay}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource AccentColor}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Currently Selected Pill -->
                <Border
                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="10,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            Text="{Binding SelectedCoffeeType.DisplayText, FallbackValue='No coffee selected'}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="✓ Selected"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource SuccessColor}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Modal Footer Actions -->
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" Margin="0,6,0,0">
                <Button
                    Grid.Column="0"
                    Text="🗑 Delete"
                    Style="{StaticResource DestructiveButtonStyle}"
                    HeightRequest="34"
                    Padding="12,0"
                    FontSize="12"
                    Clicked="OnDeleteClicked" />

                <Button
                    Grid.Column="2"
                    Text="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HeightRequest="34"
                    Padding="14,0"
                    FontSize="12"
                    Clicked="OnCancelClicked" />

                <Button
                    Grid.Column="3"
                    Text="Save Changes"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="34"
                    Padding="14,0"
                    FontSize="12"
                    Clicked="OnSaveClicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
