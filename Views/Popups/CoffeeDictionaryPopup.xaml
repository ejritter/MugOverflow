<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:vm="clr-namespace:MugOverflowProject.ViewModels"
    xmlns:models="clr-namespace:MugOverflowProject.Models"
    xmlns:popups="clr-namespace:MugOverflowProject.Views.Popups"
    x:Class="MugOverflowProject.Views.Popups.CoffeeDictionaryPopup"
    x:DataType="vm:CoffeeDictionaryPopupViewModel"
    BackgroundColor="Transparent"
    Padding="0"
    Margin="0">

    <Border
        Style="{StaticResource CardBorderStyle}"
        MaximumWidthRequest="680"
        Padding="22,20"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <Grid RowDefinitions="Auto, *, Auto" RowSpacing="14">
            <!-- Modal Header (Row 0) -->
            <VerticalStackLayout Grid.Row="0" Spacing="10">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Border
                        Grid.Column="0"
                        StrokeThickness="0"
                        WidthRequest="42"
                        HeightRequest="42">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource PrimaryGradientStart}" Offset="0.0" />
                                <GradientStop Color="{DynamicResource PrimaryGradientEnd}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <fluent:SymbolIcon
                            Symbol="BookOpen"
                            FontSize="20"
                            ForegroundColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="House Coffee &amp; Caffeine Menu" Style="{StaticResource MediumLabelStyle}" FontSize="18" />
                        <Label Text="Crafted coffeehouse pours &amp; caffeine doses • USDA &amp; Mayo Clinic" Style="{StaticResource CaptionLabelStyle}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="✕"
                        Style="{StaticResource SecondaryButtonStyle}"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="12"
                        Padding="0"
                        Clicked="OnCloseClicked" />
                </Grid>

                <!-- Context Tip Pill -->
                <Border
                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="12,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label
                        Text="☕  Tap any drink below to pair its caffeine dose with your Barista chat"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                </Border>
            </VerticalStackLayout>

            <!-- 2-Column Bento Beverage Grid -->
            <CollectionView
                Grid.Row="1"
                HeightRequest="420"
                VerticalScrollBarVisibility="Always"
                SelectionMode="None"
                ItemsSource="{Binding Items}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="2"
                        HorizontalItemSpacing="10"
                        VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CoffeeType">
                        <Border
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1"
                            Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type popups:CoffeeDictionaryPopup}}, Path=BindingContext.SelectCoffeeCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                                <!-- Row 0: Name & Volume -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalOptions="Center">
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Name}"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        LineBreakMode="TailTruncation"
                                        VerticalOptions="Center" />
                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeThickness="0.5"
                                        Padding="6,2"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding Volume}"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </Border>
                                </Grid>

                                <!-- Row 1: Short Description -->
                                <Label
                                    Grid.Row="1"
                                    Text="{Binding Desc}"
                                    Style="{StaticResource CaptionLabelStyle}"
                                    FontSize="10"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation" />

                                <!-- Row 2: Caffeine Badge & Select Button -->
                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalOptions="Center" Margin="0,2,0,0">
                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeThickness="0.5"
                                        Padding="8,3"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding CaffeineDisplay}"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            TextColor="{DynamicResource SecondaryColor}" />
                                    </Border>

                                    <Button
                                        Grid.Column="1"
                                        Text="Pair"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HeightRequest="28"
                                        CornerRadius="10"
                                        Padding="12,0"
                                        FontSize="11"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type popups:CoffeeDictionaryPopup}}, Path=BindingContext.SelectCoffeeCommand}"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Modal Footer -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,2,0,0" VerticalOptions="Center">
                <Label
                    Grid.Column="0"
                    Text="10 house coffeehouse pours • 8 oz standard cup reference"
                    Style="{StaticResource CaptionLabelStyle}"
                    FontSize="11"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Text="Close"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HeightRequest="34"
                    CornerRadius="12"
                    Padding="16,0"
                    FontSize="12"
                    Clicked="OnCloseClicked" />
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
