<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:vm="clr-namespace:MugOverflowProject.ViewModels"
    xmlns:models="clr-namespace:MugOverflowProject.Models"
    x:Class="MugOverflowProject.Views.Popups.CoffeeDictionaryPopup"
    x:DataType="vm:CoffeeDictionaryPopupViewModel">

    <Border
        Style="{StaticResource CardBorderStyle}"
        MaximumWidthRequest="640"
        Margin="16"
        Padding="18"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <Grid RowDefinitions="Auto, *, Auto" RowSpacing="12">
            <!-- Modal Header (Row 0) -->
            <VerticalStackLayout Grid.Row="0" Spacing="8">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        StrokeThickness="0"
                        Padding="10"
                        WidthRequest="40"
                        HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <fluent:SymbolIcon
                            Symbol="BookOpen"
                            FontSize="20"
                            ForegroundColor="{DynamicResource PrimaryColor}" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="Coffee Type Guide" Style="{StaticResource MediumLabelStyle}" FontSize="18" />
                        <Label Text="Standard caffeine ratings sourced from USDA FoodData Central &amp; Mayo Clinic" Style="{StaticResource CaptionLabelStyle}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="✕"
                        Style="{StaticResource SecondaryButtonStyle}"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        Clicked="OnCloseClicked" />
                </Grid>

                <!-- Helpful Tip Banner -->
                <Border
                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="10,5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label
                        Text="💡 Tap any coffee card or click 'Select' to pick your drink (including Decaf)"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                </Border>
            </VerticalStackLayout>

            <!-- 2-Column Responsive Grid with Guaranteed Height and Scrollability -->
            <CollectionView
                Grid.Row="1"
                HeightRequest="410"
                VerticalScrollBarVisibility="Always"
                SelectionMode="None"
                ItemsSource="{Binding Items}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="2"
                        HorizontalItemSpacing="8"
                        VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CoffeeType">
                        <Border
                            BackgroundColor="{DynamicResource SurfaceColor}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1"
                            Padding="10,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoffeeDictionaryPopupViewModel}}, Path=SelectCoffeeCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="4">
                                <!-- Row 0: Name & Volume -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="4" VerticalOptions="Center">
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Name}"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        LineBreakMode="TailTruncation"
                                        VerticalOptions="Center" />
                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        StrokeThickness="0"
                                        Padding="5,1"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding Volume}"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </Border>
                                </Grid>

                                <!-- Row 1: Short Description -->
                                <Label
                                    Grid.Row="1"
                                    Text="{Binding Desc}"
                                    Style="{StaticResource CaptionLabelStyle}"
                                    FontSize="10"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation" />

                                <!-- Row 2: Caffeine Badge & Select Button -->
                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalOptions="Center" Margin="0,2,0,0">
                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeThickness="0.5"
                                        Padding="6,2"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding CaffeineDisplay}"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            TextColor="{DynamicResource AccentColor}" />
                                    </Border>

                                    <Button
                                        Grid.Column="1"
                                        Text="Select"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HeightRequest="28"
                                        Padding="10,0"
                                        FontSize="11"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoffeeDictionaryPopupViewModel}}, Path=SelectCoffeeCommand}"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Modal Footer -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                <Label
                    Grid.Column="0"
                    Text="All 10 standard coffee types available • 8 oz standard serving."
                    Style="{StaticResource CaptionLabelStyle}"
                    FontSize="10"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Text="Close"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HeightRequest="32"
                    Padding="14,0"
                    FontSize="11"
                    Clicked="OnCloseClicked" />
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
