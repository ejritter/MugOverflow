<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:vm="clr-namespace:MugOverflowProject.ViewModels"
    x:Class="MugOverflowProject.Views.Popups.ThemeSelectorPopup"
    x:DataType="vm:ThemeSelectorPopupViewModel">

    <Border
        Style="{StaticResource CardBorderStyle}"
        MaximumWidthRequest="420"
        Margin="16"
        Padding="20"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <VerticalStackLayout Spacing="16">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                    StrokeThickness="0"
                    Padding="10"
                    WidthRequest="42"
                    HeightRequest="42">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <fluent:SymbolIcon
                        Symbol="Settings"
                        FontSize="20"
                        ForegroundColor="{DynamicResource PrimaryColor}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Select Theme" Style="{StaticResource MediumLabelStyle}" FontSize="18" />
                    <Label Text="Choose your preferred visual palette" Style="{StaticResource CaptionLabelStyle}" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="✕"
                    Style="{StaticResource SecondaryButtonStyle}"
                    WidthRequest="36"
                    HeightRequest="36"
                    Padding="0"
                    Clicked="OnCloseClicked" />
            </Grid>

            <!-- Theme Choices -->
            <VerticalStackLayout Spacing="8">
                <!-- 1. Regal Earth (Default) -->
                <Button
                    Text="👑 Regal Earth (Purple / Gold)"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SelectThemeCommand}"
                    CommandParameter="Regal Earth">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding SelectedThemeName}"
                            Value="Regal Earth">
                            <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- 2. Wine Desert -->
                <Button
                    Text="🍷 Wine Desert (Wine / Tan)"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SelectThemeCommand}"
                    CommandParameter="Wine Desert">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding SelectedThemeName}"
                            Value="Wine Desert">
                            <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- 3. Forest Lavender -->
                <Button
                    Text="🌲 Forest Lavender (Green / Lavender)"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SelectThemeCommand}"
                    CommandParameter="Forest Lavender">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding SelectedThemeName}"
                            Value="Forest Lavender">
                            <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- 4. Pristine Clean -->
                <Button
                    Text="🌊 Pristine Clean (Teal / Mint)"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SelectThemeCommand}"
                    CommandParameter="Pristine Clean">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding SelectedThemeName}"
                            Value="Pristine Clean">
                            <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- 5. Coffee Light (Latte / Caramel) -->
                <Button
                    Text="☕ Coffee Light (Latte / Caramel)"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SelectThemeCommand}"
                    CommandParameter="Coffee Light">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding SelectedThemeName}"
                            Value="Coffee Light">
                            <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- 6. Coffee Dark (Espresso / Mocha) -->
                <Button
                    Text="🌙 Coffee Dark (Espresso / Mocha)"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding SelectThemeCommand}"
                    CommandParameter="Coffee Dark">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding SelectedThemeName}"
                            Value="Coffee Dark">
                            <Setter Property="Style" Value="{StaticResource PrimaryButtonStyle}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>

            <!-- Footer -->
            <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                <Button
                    Text="Done"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="OnCloseClicked" />
                <Label
                    Text="AI engineered by EJRitter Development"
                    Style="{StaticResource CaptionLabelStyle}"
                    HorizontalTextAlignment="Center"
                    FontSize="11" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
