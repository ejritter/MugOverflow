<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MugOverflowProject.Resources.Styles.Themes.WineDesertDarkTheme">

    <x:String x:Key="ThemeName">Mocha Velvet Dark</x:String>

    <Color x:Key="PageBackgroundColor">#1B1214</Color>
    <Color x:Key="NavigationBarColor">#120B0D</Color>
    <Color x:Key="PrimaryColor">#EA859B</Color>
    <Color x:Key="SecondaryColor">#E2A775</Color>
    <Color x:Key="AccentColor">#E2A775</Color>
    <Color x:Key="SurfaceColor">#261A1E</Color>
    <Color x:Key="SurfaceAltColor">#38262C</Color>
    <Color x:Key="BorderColor">#523840</Color>

    <Color x:Key="PrimaryTextColor">#F9EFEF</Color>
    <Color x:Key="SecondaryTextColor">#D2B8BE</Color>
    <Color x:Key="TertiaryTextColor">#9E828A</Color>

    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FFA726</Color>
    <Color x:Key="ErrorColor">#EF5350</Color>
    <Color x:Key="InfoColor">#4DB6AC</Color>
    <Color x:Key="DecorativeColor">#523840</Color>
    <Color x:Key="TransparentColor">Transparent</Color>

    <Color x:Key="PrimaryGradientStart">#EA859B</Color>
    <Color x:Key="PrimaryGradientEnd">#E2A775</Color>
    <Color x:Key="CardShadowColor">#40000000</Color>
    <Color x:Key="AppShadowColor">#66000000</Color>

    <Color x:Key="PrimaryButtonTextColor">#1B1214</Color>
