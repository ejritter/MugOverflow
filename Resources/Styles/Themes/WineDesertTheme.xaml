    <Color x:Key="TertiaryTextColor">#8A7568</Color>

    <Color x:Key="SuccessColor">#286140</Color>
    <Color x:Key="WarningColor">#B85C00</Color>
    <Color x:Key="ErrorColor">#A31621</Color>
    <Color x:Key="InfoColor">#2C6F73</Color>
