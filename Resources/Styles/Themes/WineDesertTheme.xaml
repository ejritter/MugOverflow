<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MugOverflowProject.Resources.Styles.Themes.WineDesertTheme">

    <x:String x:Key="ThemeName">Wine Desert</x:String>

    <Color x:Key="PageBackgroundColor">#F6E7D2</Color>
    <Color x:Key="NavigationBarColor">#6B1E36</Color>
    <Color x:Key="PrimaryColor">#6B1E36</Color>
    <Color x:Key="AccentColor">#7B3F00</Color>
    <Color x:Key="SurfaceColor">#FFF7EC</Color>
    <Color x:Key="SurfaceAltColor">#D9B88F</Color>
    <Color x:Key="BorderColor">#B99A77</Color>

    <Color x:Key="PrimaryTextColor">#241A17</Color>
