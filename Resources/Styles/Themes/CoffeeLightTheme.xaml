<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MugOverflowProject.Resources.Styles.Themes.CoffeeLightTheme">

    <x:String x:Key="ThemeName">Coffee Light</x:String>

    <Color x:Key="PageBackgroundColor">#FBF8F2</Color>
    <Color x:Key="NavigationBarColor">#5C3818</Color>
    <Color x:Key="PrimaryColor">#5C3818</Color>
    <Color x:Key="SecondaryColor">#C4823F</Color>
    <Color x:Key="AccentColor">#C4823F</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F2EBE1</Color>
    <Color x:Key="BorderColor">#E5DCB8</Color>

    <Color x:Key="PrimaryTextColor">#1C1510</Color>
    <Color x:Key="SecondaryTextColor">#7A6A58</Color>
    <Color x:Key="TertiaryTextColor">#A39281</Color>

    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="ErrorColor">#C62828</Color>
    <Color x:Key="InfoColor">#0288D1</Color>
    <Color x:Key="DecorativeColor">#E5DCB8</Color>
    <Color x:Key="TransparentColor">Transparent</Color>

    <Color x:Key="PrimaryGradientStart">#5C3818</Color>
    <Color x:Key="PrimaryGradientEnd">#C4823F</Color>
    <Color x:Key="CardShadowColor">#1A1C1510</Color>
    <Color x:Key="AppShadowColor">#261C1510</Color>

    <Color x:Key="PrimaryButtonTextColor">White</Color>
    <Color x:Key="AccentButtonTextColor">#1C1510</Color>
</ResourceDictionary>
